# Copy to .env and fill in real values. Never commit .env.

# --- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Comma-separated origins allowed to call the API (the React app)
CORS_ORIGINS=http://localhost:5173
# true when running behind Nginx / a load balancer, so client IPs resolve correctly
TRUST_PROXY=false
# true to let Express also serve the built React app from ../frontend/dist
SERVE_FRONTEND=false

# --- Database ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shreemadhav
DB_CONNECTION_LIMIT=10

# --- Authentication -----------------------------------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
COOKIE_NAME=smos_session

# --- Uploads ------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
MAX_SUPPORTING_FILES=4

# --- Email (reserved for notifications; not used until SMTP is configured) ------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- First administrator (used once by `npm run admin:create`) -------------------
ADMIN_NAME=Site Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
