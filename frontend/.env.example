# Public production URL, without trailing slash. Used for canonical URLs,
# Open Graph tags, sitemap.xml and robots.txt.
VITE_SITE_URL=https://www.your-domain.com

# Base URL of the API. Leave as /api when the API is served from the same
# domain (recommended, via Nginx or SERVE_FRONTEND=true on the backend).
VITE_API_BASE_URL=/api

# Development only: where the Vite dev server proxies /api requests.
VITE_DEV_API_TARGET=http://localhost:5000

# Note: everything prefixed VITE_ is bundled into public JavaScript.
# Never put secrets here.
